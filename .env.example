# ---- Next.js (Vercel env) ----
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Shared secret between Next.js API routes and Convex server* functions (>= 16 chars).
# Must ALSO be set in Convex:  npx convex env set SERVER_SECRET <same value>
SERVER_SECRET=

# Stripe (Connect must be enabled on the platform account)
STRIPE_SECRET_KEY=sk_test_...
# Webhook endpoint #1: https://<app>/api/webhooks/stripe  (events: checkout.session.completed,
#   checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#   checkout.session.expired, charge.refunded, charge.dispute.created)
STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook endpoint #2, same URL, "Events on Connected accounts": account.updated
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_FEE_BPS=1000
# Minimum platform fee on digital sales, minor units (Stripe charges the platform a processing fee)
STRIPE_MIN_FEE=50
# Country for new Express accounts (ISO-2). Omit to let artists pick during onboarding.
STRIPE_CONNECT_COUNTRY=GB
# Prodigi cost per print in minor units INCLUDING POSTAGE, recovered via the platform fee.
# Also set PRINT_COST_* and PRINTS_ENABLED=true in the Convex env (npx convex env set) to enable the print price guard.
PRINT_COST_A5=600
PRINT_COST_A4=900
PRINT_COST_A3=1500

# Prodigi (sandbox: https://api.sandbox.prodigi.com/v4.0, live: https://api.prodigi.com/v4.0)
PRODIGI_API_KEY=
PRODIGI_BASE_URL=https://api.sandbox.prodigi.com/v4.0
PRODIGI_SKU_A5=GLOBAL-ART-A5
PRODIGI_SKU_A4=GLOBAL-ART-A4
PRODIGI_SKU_A3=GLOBAL-ART-A3
# Random string; appended to the status callback URL we give Prodigi (it does not sign callbacks)
PRODIGI_WEBHOOK_SECRET=

# Email receipts (Resend)
RESEND_API_KEY=
EMAIL_FROM="Drawn Checkout <receipts@yourdomain.com>"

# ---- Convex env (npx convex env set NAME value) ----
# SERVER_SECRET        same as above
# CLERK_JWT_ISSUER_DOMAIN   e.g. https://your-app.clerk.accounts.dev
# ADMIN_USER_IDS       comma-separated Clerk user ids allowed to see /admin
# ADMIN_EMAILS         (optional) comma-separated admin emails
